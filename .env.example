# ==============================================================================
# Meeting & Video Intelligence — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha apenas os provedores que utilizar.
# ==============================================================================

# --- Servidor & Armazenamento Local ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8185
DATA_DIR=./data
CORS_ORIGINS=http://mvi.localhost:5185,http://localhost:5185,http://127.0.0.1:5185,http://mvi.localhost:8185,http://localhost:8185,http://127.0.0.1:8185

# --- Provedor de Transcrição de Áudio/Vídeo ---
# Opções: gemini | local_whisper
TRANSCRIBER_PROVIDER=gemini
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
AUDIO_CHUNK_MINUTES=20

# --- Transcrição 100% Offline (faster-whisper) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# --- Provedor de LLM para Sumarização, Extração & Q&A ---
# Opções: gemini | openai | azure_openai | databricks | ollama | heuristic
LLM_PROVIDER=gemini

# Google Gemini (padrão local)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI (opcional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama Local (opcional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Databricks (opcional — Model Serving / Upload para Volume UC / Lakeflow Pipeline)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_PROFILE=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_VOLUME_NAME=raw_transcripts
DATABRICKS_PIPELINE_ID=
DATABRICKS_LLM_ENDPOINT=system.ai.databricks-meta-llama-3-3-70b-instruct
